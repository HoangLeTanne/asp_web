@model IEnumerable<SanPham>
<style>
    .table-container {
        background-color: #f8f9fa; /* Light gray background */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

        .table-container h3 {
            font-weight: bold;
            color: #2c3e50; /* Dark blue */
            border-bottom: 2px solid #2c3e50; /* Bottom border for title */
            padding-bottom: 10px;
        }

    .table {
        margin-top: 20px;
        width: 100%;
        border-collapse: collapse;
    }

        .table, .table th, .table td {
            border: 1px solid #dee2e6; /* Border for each cell */
        }

            .table th {
                background-color: #e9ecef;
                color: #495057; /* Dark gray */
                text-align: center;
                padding: 10px;
            }

            .table td {
                padding: 10px;
                text-align: left;
            }

    .btn-primary {
        margin-bottom: 10px;
    }

    .table img {
        max-width: 80px; /* Limit image width */
        height: auto;
        border-radius: 5px;
    }
</style>

<div class="container">
    <div class="table-container">
        <h3>Quản Lý Sản Phẩm</h3>
        <a asp-controller="SanPham" asp-action="Upsert" class="btn btn-primary">Thêm mới</a>
        <table class="table">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Mô tả</th>
                    <th>Giá</th>
                    <th>Hình ảnh</th>
                    <th>Thể loại</th>
                    <th>Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.price</td>
                        <td><img src="@item.ImageUrl" /></td>
                        <td>@item.TheLoai.Name</td>
                        <td>
                            <a asp-action="Upsert" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Details">Details</a> |
                            <a class="text-danger" onclick="confirmDelete(@item.Id, $(this))">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function confirmDelete(id, row) {
        if (confirm("Bạn có chắc chắn muốn xóa?")) {
            xoa(id, $(row));
        }
    }
    function xoa(idx, row) {
        $.ajax({
            url: `SanPham/Delete`,
            type: 'POST',
            data: { id: idx },
            success: function (data) {
                if (data.success) {
                    row.closest("tr").remove();
                } else {
                    alert(data.message);
                }
            },
            error: function (xhr, status, error) {
                alert("Xóa thất bại: " + error);
            }
        });
    }
</script>