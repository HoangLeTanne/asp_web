<style>
    .card {
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        transition: box-shadow 0.3s ease;
    }

        .card:hover {
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.2);
        }

    .product-image {
        transition: transform 0.3s ease;
    }

        .product-image:hover {
            transform: scale(1.05);
        }
</style>
<div class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h1 class="text-center">Danh sách sản phẩm</h1>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4 d-flex align-items-stretch">
                <div class="card w-100" style="min-height: 100%; display: flex; flex-direction: column;">
                    <a asp-action="Details" asp-route-sanphamId="@item.Id">
                        <img src="@item.ImageUrl" alt="Product image" class="product-image" style="width: 80%; height: auto;">
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <h6 class="card-title text-danger">@(string.Format("{0:N0}", item.price)) đ</h6>
                        <p class="card-text">@item.Description</p>
                        <div class="row mt-auto">
                            <div class="col-6">
                                <form asp-action="AddToCart" method="post">
                                    <input type="hidden" name="sanphamId" value="@item.Id" />
                                    <button type="submit" class="btn btn-primary w-100">Thêm &#10084</button>
                                </form>
                            </div>
                            <div class="col-6">
                                <a href="#" class="btn btn-primary w-100">Mua Hàng</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>





