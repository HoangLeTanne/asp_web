﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <img src="/img/logo.png" class="img-fluid" style="max-width: 75px;">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-parent" href="/"><b>Trang chủ</b></a>
                        </li>
                        @await Component.InvokeAsync("TheLoai")

                        <li class="nav-item dropdown">
                            <a class="nav-link bg-transparent dropdown-toggle" href="/collection/all" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <b> Sản phẩm</b>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="/collection/all"><b>Xem tất cả</b></a></li>
                                <li><a class="dropdown-item" href="/collection/tai-nghe"><b>Tai nghe</b></a></li>
                                <li><a class="dropdown-item" href="/collection/may-tinh"><b>Máy tính</b></a></li>
                                <li><a class="dropdown-item" href="/collection/ban-phim"><b>Bàn phím </b></a></li>
                                <li><a class="dropdown-item" href="/collection/chuot"><b>Chuột gaming</b></a></li>
                                <li><a class="dropdown-item" href="/collection/card-do-hoa"><b>Card đồ họa</b></a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-parent" asp-controller="Home" asp-action="GioiThieu"><b>Giới thiệu</b></a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-parent" asp-controller="Home" asp-action="LienHe"><b>Liên hệ</b></a>
                        </li>

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://taocuoi.vn/wp-content/uploads/2024/05/banner-home-3-m.webp" class="d-block w-100" alt="Banner 1">
            </div>
            <div class="carousel-item">
                <img src="https://cdn.tgdd.vn/hoi-dap/1355217/banner-tgdd-800x300.jpg" class="d-block w-100" alt="Banner 2">
            </div>
            <div class="carousel-item">
                <img src="https://baotinmobile.vn/uploads/2023/03/sl-iphone-14-promax.jpg.webp" class="d-block w-100" alt="Banner 3">
            </div>
        </div>
        <!-- Carousel controls (next and previous) -->
        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <style>
        #bannerCarousel .carousel-inner img {
            height: 400px; /* Set a fixed height for the banners */
            width: 100%; /* Ensures the image covers the full width */
            object-fit: contain; /* Ensures the entire image fits within the given dimensions */
            border-radius: 10px; /* Optional: Adds rounded corners */
        }
    </style>


    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <style>
        /* Footer container background */
        footer.bg-light {
            background-color: #f9f9f9;
        }

        /* Pastel color styling */
        footer h2, footer h4 {
            font-weight: bold;
        }

        /* Pastel color for each section */
        footer h2 {
            color: #ffb3ba; /* Light pastel pink for "Liên Hệ Chúng Tôi" */
        }

        footer .col-md-4:nth-child(1) h4 {
            color: #ffdfba; /* Light pastel peach for "Giới Thiệu" */
        }

        footer .col-md-4:nth-child(2) h4 {
            color: #baffc9; /* Light pastel green for "Dịch Vụ Khách Hàng" */
        }

        footer .col-md-4:nth-child(3) h4 {
            color: #bae1ff; /* Light pastel blue for "Chính Sách Bảo Mật" */
        }

        /* General footer text */
        footer p {
            color: #555; /* Slightly darker color for readability */
        }
    </style>

    <footer class="bg-light text-center mt-5 py-4">
        <div class="container">
            <h2>Liên Hệ Chúng Tôi</h2>
            <p>Email: contact@letan.com</p>
            <p>Điện Thoại: 0123456789</p>

            <div class="row">
                <div class="col-md-4">
                    <h4>Giới Thiệu</h4>
                    <p>Thông tin giới thiệu về sản phẩm.</p>
                </div>
                <div class="col-md-4">
                    <h4>Dịch Vụ Khách Hàng</h4>
                    <p>Thông tin về dịch vụ khách hàng.</p>
                </div>
                <div class="col-md-4">
                    <h4>Chính Sách Bảo Mật</h4>
                    <p>Thông tin về chính sách bảo mật của chúng tôi.</p>
                </div>
            </div>
            <p>&copy; 2024 Bản quyền thuộc letan.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>